# Build outputs: regenerable.
out-vanilla/
out-ltram/
modbuild/
hostdeps/

# Archived kernel images and modules are too large for git. The RECORD of each
# baseline -- RESULT.md, the resolved config, SHA256SUMS -- is tracked; the binaries
# live on disk beside it and in the snapshot zip.
baselines/*/Image
baselines/*/initrd.img
baselines/*/modules.tar.gz
baselines/*/System.map
baselines/*/*.ko

# Compiled workloads
workloads/*/matmul
workloads/*/matmul.native
workloads/*/ltram-inspect
workloads/*/ltram-inspect.native
*.o

build-*.log
probe_*.log

# Prebuilt workload binaries (rebuild with each workload's Makefile)
workloads/pagerank/workloads/pr
workloads/rwstress/ltram_rw_stress
workloads/basic_tests/cow_to_dram

# build-step.sh's throwaway worktrees. No trailing slash: git treats an embedded
# repository as a gitlink rather than a directory, so ".step-worktrees/" would not
# match and it would be staged as a broken submodule pointer.
.step-worktrees
.claude/sekekama/
