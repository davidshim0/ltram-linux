#!/bin/bash
# ltram-erase-counts -- carry the per-sector erase counts across a power cycle.
#
# WHAT IS PERSISTED
#   /sys/kernel/debug/ltram/erase_counts is a 16-byte header ("LTEC", version,
#   nr_pages) followed by one u32 per sector. The kernel validates that header
#   on the first write and rebuilds the allocator's wear buckets when the last
#   byte lands. A SHORT BLOB IS THEREFORE DANGEROUS: the body would be pasted
#   in without the rebuild, leaving lt_pop_clean() handing out by the old order
#   while the counts say otherwise, which is LT_ERR_BUCKET_MEMBER. Both
#   directions check the size before writing anything.
#
# WHAT IT IS WORTH
#   Every count is a LOWER BOUND. An unclean shutdown loses whatever
#   accumulated since the last save, and nothing here can recover it.
#
#   That is the right direction to be wrong in. Undercounting sends a write to
#   a sector believed fresher than it is. Overcounting would crowd the sectors
#   still believed fresh -- which is the exact failure the wear machinery
#   exists to prevent.
#
#   And the counts mean "erases since counting began", not the device's
#   history. This chip took heavy unknown wear during FPGA bring-up, before any
#   of this existed, and no amount of bookkeeping recovers that.
#
# WHERE IT LIVES
#   /var/lib/ltram/erase_counts, on root. NOT /scratch: that is NFS, unmounted
#   by the time a shutdown hook runs and not guaranteed at early boot. z08's
#   root sits at 98% with ~114 MB free, so the 256 KB blob plus one generation
#   of backup is checked for space rather than assumed.
set -u
DBG=/sys/kernel/debug/ltram
STATE=/var/lib/ltram
F=$STATE/erase_counts
EPOCHF=$STATE/wear_epoch
EPOCHP=/sys/module/ltram_policy/parameters/wear_epoch
HIST=$STATE/wear-history.tsv
HDR=16

# THE EPOCH IS A DATE, NOT A MEASUREMENT.
#
# wear_epoch says when the service life started, and the wear budget divides
# by the time remaining from it. The kernel carries a compiled-in default, so
# without a file on disk the date silently resets on every boot -- and moves
# again the first time the kernel is rebuilt with a different constant. Then
# "cycles_left / seconds_left" is dividing by a number that changed for
# reasons having nothing to do with the device.
#
# So the FILE is the authority, and it is written once. restore pushes it into
# the parameter; if it does not exist yet, restore seeds it from whatever the
# kernel booted with, which stamps the date exactly once.
#
# save deliberately does NOT copy the parameter back. Experiments move
# wear_epoch to change the promotion rate -- backdating it is how you ask for
# 1.5 ms instead of 24 ms -- and an experiment must never be able to make
# itself permanent. Use "epoch VALUE" to change the record on purpose.
die(){ echo "ltram-erase-counts: $*" >&2; exit 1; }
note(){ echo "ltram-erase-counts: $*"; }

# A row of wear distribution, appended on every save and every restore -- which
# is already boot, plus before and after every measured point.
#
# NOT a pass/fail, for a sharper reason than I first thought.
#
# The ALLOCATOR's buckets are LT_EC_GRAIN = 1000 erases wide (101 of them,
# covering 0..100,000). The log2 "ec_histogram" printed beside them in
# pagestate is display only. So with counts around 20-35, every sector sits in
# bucket 0 and will keep sitting there until one reaches 1000 erases -- about
# 65 million more erases away at the current mean.
#
# Which means the bucket ORDER is doing nothing yet: inside a bucket the free
# list is FIFO, so today's levelling is pure round-robin over the pool. That
# is why the spread stays tight, and why a bucket-based assertion would be
# testing machinery that has not started working.
#
# What is left to watch is the spread, and only as a trend -- a single reading
# cannot show one. This records it.
#
# The interesting column is spread against mean. Levelling is working if that
# ratio falls as erases accumulate: it went from 8/9.9 = 81% to 10/23.6 = 42%
# over the first campaign, which is the distribution tightening, not widening.
wear_row(){
    local ev="$1" ps mn mx sp tot nb
    [ -r $DBG/pagestate ] || return 0
    ps=$(cat $DBG/pagestate 2>/dev/null) || return 0
    mn=$(sed -n 's/.*erase_count *min \([0-9]*\).*/\1/p' <<<"$ps")
    mx=$(sed -n 's/.*max \([0-9]*\) *spread.*/\1/p' <<<"$ps")
    sp=$(sed -n 's/.*spread \([0-9]*\).*/\1/p' <<<"$ps")
    tot=$(awk '/^total_allocs/{print $2; exit}' <<<"$ps")
    # ONLY the allocator's clean_buckets, not the log2 display histogram
    # that precedes it -- counting both gave 3 on a pool entirely in bucket 0.
    nb=$(sed -n '/^clean_buckets/,$p' <<<"$ps" | grep -c '^  \[')
    # Median as well as mean. The mean is total/65536 by construction, so it
    # cannot disagree with itself -- but a median below it says a few sectors
    # are pulling the average up, which is the skew worth watching.
    md=$(cat $DBG/erase_counts 2>/dev/null | od -An -tu4 -j16 -v | tr -s " " "\n" |
         grep -v "^$" | sort -n | awk '{v[n++]=$1} END{print (n? v[int(n/2)] : "?")}')
    mkdir -p $STATE
    [ -f $HIST ] || echo -e "when\tevent\ttotal\tmin\tmax\tspread\tmean\tbuckets\tdata\tdirty\tclean" > $HIST
    printf "%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n" \
      "$(date -Iseconds)" "$ev" "${tot:-?}" "${mn:-?}" "${mx:-?}" "${sp:-?}" \
      "$(awk -v t="${tot:-0}" 'BEGIN{printf "%.1f", t/65536}')" "${md:-?}" "${nb:-?}" \
      "$(awk '/^data/{print $2; exit}' <<<"$ps")" \
      "$(awk '/^dirty/{print $2; exit}' <<<"$ps")" \
      "$(awk '/^clean/{print $2; exit}' <<<"$ps")" >> $HIST
    # Root sits at 99%, so bound it rather than letting a long campaign grow
    # a file nobody is watching.
    if [ "$(wc -l < $HIST)" -gt 5000 ]; then
        { head -1 $HIST; tail -4000 $HIST; } > $HIST.tmp && mv -f $HIST.tmp $HIST
    fi
}

expected_size(){
    local lo hi n
    lo=$(cat $DBG/start_pfn 2>/dev/null) || return 1
    hi=$(cat $DBG/end_pfn   2>/dev/null) || return 1
    n=$((hi - lo)); [ "$n" -gt 0 ] || return 1
    echo $((HDR + 4 * n))
}

case "${1:-}" in
history)
    [ -f $HIST ] || { note "no history yet at $HIST"; exit 0; }
    N=${2:-20}
    { head -1 $HIST; tail -n "$N" $HIST; } | column -t -s $'\t'
    echo
    echo "spread/mean is the number to watch. buckets are 1000 erases wide, so"
    echo "everything stays in bucket 0 until a sector reaches 1000 -- inside a"
    echo "bucket the free list is FIFO, so levelling today is round-robin."
    ;;
mark)
    # For pinning a point in the trend by hand, e.g. before a campaign.
    wear_row "${2:-mark}"; note "recorded '${2:-mark}' in $HIST"
    ;;
epoch)
    [ -r $EPOCHP ] || die "no $EPOCHP -- this kernel has no wear governor"
    if [ -n "${2:-}" ]; then
        case "$2" in *[!0-9]*|"") die "epoch must be seconds since the Unix epoch";; esac
        mkdir -p $STATE
        echo "$2" > $EPOCHF
        echo "$2" > $EPOCHP
        note "epoch set to $2 ($(date -u -d @$2 2>/dev/null))"
    else
        echo "live:  $(cat $EPOCHP)  ($(date -u -d @$(cat $EPOCHP) 2>/dev/null))"
        if [ -f $EPOCHF ]; then
            echo "saved: $(cat $EPOCHF)  ($(date -u -d @$(cat $EPOCHF) 2>/dev/null))"
        else
            echo "saved: none -- run restore to stamp it"
        fi
    fi
    ;;
save)
    [ -r $DBG/erase_counts ] || { note "no $DBG/erase_counts -- not an LtRAM kernel, nothing to save"; exit 0; }
    WANT=$(expected_size) || die "cannot read the pfn window"
    mkdir -p $STATE
    FREE=$(df -k $STATE | awk 'NR==2{print $4}')
    [ "${FREE:-0}" -lt 2048 ] && die "only ${FREE} KB free on $STATE -- refusing to write a possibly truncated blob"
    # temp-then-rename: a crash mid-save leaves the previous generation intact
    # rather than a half-written file that restore would refuse.
    cat $DBG/erase_counts > $F.tmp || die "read failed"
    GOT=$(stat -c %s $F.tmp)
    if [ "$GOT" != "$WANT" ]; then rm -f $F.tmp; die "read $GOT bytes, expected $WANT -- not saving"; fi
    [ -f $F ] && cp -f $F $F.prev 2>/dev/null
    mv -f $F.tmp $F
    sync -f $F 2>/dev/null || sync
    wear_row save
    note "saved $GOT bytes to $F"
    ;;
restore)
    # The epoch first: it is independent of the counts and must be right even
    # on a first boot where no blob exists yet.
    if [ -w $EPOCHP ]; then
        mkdir -p $STATE
        if [ -f $EPOCHF ]; then
            E=$(cat $EPOCHF)
            cat $EPOCHF > $EPOCHP && note "wear epoch restored: $E ($(date -u -d @$E 2>/dev/null))"
        else
            E=$(cat $EPOCHP)
            echo "$E" > $EPOCHF
            note "wear epoch stamped for the first time: $E ($(date -u -d @$E 2>/dev/null))"
        fi
    fi
    [ -w $DBG/erase_counts ] || { note "no $DBG/erase_counts -- not an LtRAM kernel, nothing to restore"; exit 0; }
    [ -f $F ] || { note "no saved counts at $F -- first boot, starting from zero"; exit 0; }
    WANT=$(expected_size) || die "cannot read the pfn window"
    GOT=$(stat -c %s $F)
    if [ "$GOT" != "$WANT" ]; then
        die "$F is $GOT bytes, this kernel wants $WANT -- window size changed, refusing (a short blob restores without rebuilding the buckets)"
    fi
    # cat, not dd: the kernel's first write consumes exactly the 16-byte header
    # and returns 16, so the writer MUST handle a short write. coreutils cat
    # loops on partial writes; dd reports them and moves on.
    cat $F > $DBG/erase_counts || die "restore failed -- check dmesg for a rejected header"
    note "restored $GOT bytes from $F"
    wear_row restore
    dmesg 2>/dev/null | tail -20 | grep -E "ltram: (erase counts restored|erase-count blob rejected)" | tail -1
    ;;
show)
    [ -r $DBG/erase_counts ] || die "no $DBG/erase_counts"
    cat $DBG/erase_counts | od -An -tu4 -j $HDR -v | tr -s ' ' '\n' | grep -v '^$' | \
      awk '{n++; s+=$1; if($1>mx)mx=$1; if(n==1||$1<mn)mn=$1; if($1)nz++}
           END{printf "live:  %d sectors  min %d  max %d  mean %.1f  nonzero %d (%.1f%%)  total erases %d\n",
                      n, mn, mx, (n?s/n:0), nz, (n?100.0*nz/n:0), s}'
    [ -f $F ] && { echo -n "saved: "; stat -c '%s bytes, %y' $F; } || echo "saved: none"
    if [ -r $EPOCHP ]; then
        E=$(cat $EPOCHP)
        echo "epoch: $E ($(date -u -d @$E 2>/dev/null))$([ -f $EPOCHF ] && [ "$(cat $EPOCHF)" != "$E" ] && echo "  != saved $(cat $EPOCHF)")"
        [ -r /sys/kernel/debug/ltram/wear ] && awk '/^interval_ms|^cycles_left|^seconds_left/{printf "  %-14s %s\n", $1, $2}' /sys/kernel/debug/ltram/wear
    fi
    ;;
*)
    echo "usage: $0 {save|restore|show|epoch [UNIX_SECONDS]|history [N]|mark [LABEL]}"; exit 2;;
esac
